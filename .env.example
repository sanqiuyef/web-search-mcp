# web-search-server 环境变量示例
# 复制为 .env（或直接配到 MCP 客户端的 env 字段）；不要提交真实值。
# 所有变量都有默认值，留空即用默认。

# ── 搜索 ─────────────────────────────────────────────
# 自托管 SearXNG 实例（可选；配置后作为第 4 个引擎参与聚合）
WS_SEARXNG_URL=
# ddgs 固定后端（逗号分隔；不要用 auto，会优先百科词条且拖超时）
WS_DDGS_BACKENDS=yandex
WS_DDGS_REGION=us-en
# 默认语言与时间过滤
WS_LANGUAGE=zh-CN
# 结果缓存（秒）与相关性过滤
WS_CACHE_TTL=300
WS_RELEVANCE_FILTER=true

# ── 超时 ─────────────────────────────────────────────
WS_SEARCH_TIMEOUT=15
WS_FETCH_TIMEOUT=20
WS_BROWSER_TIMEOUT=30

# ── 抓取回退链 ───────────────────────────────────────
# 可选：Firecrawl 云抓取（未配置则跳过该级）
FIRECRAWL_API_KEY=
# 复用浏览器渲染的 CDP 端口（抓取回退链与 twitter_search 共用）
WS_CDP_PORT=9222
# 回退链最终一级（反爬/登录墙）交给 Playwright MCP 在已登录浏览器里完成，见 README

# ── Twitter(X)（可选；只在需要「静默、不弹浏览器」读 X 时配置）──
# auth_token / ct0 等同于账号凭据：只放本机 env，不入库
X_AUTH_TOKEN=
X_CT0=
# 可选：手动覆盖 SearchTimeline queryId（自动发现失败时用）
X_SEARCH_QUERY_ID=

# ── 代理（可选）────────────────────────────────────
WS_USE_PROXY=
WS_PROXY_URL=

# ── 服务（HTTP 模式时）──────────────────────────────
# WS_HOST=0.0.0.0
# WS_PORT=8011
# WS_TRANSPORT=stdio
